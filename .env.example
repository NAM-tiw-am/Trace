# Project Configuration
PROJECT_NAME="Trace - Missing Person Identification System"
VERSION="1.0.0"

# Database Configuration (PostgreSQL with pgvector)
# Note: Defaults to sqlite:///storage/trace.db if PostgreSQL is unreachable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trace_db

# InsightFace / ArcFace AI Parameters
INSIGHTFACE_MODEL=buffalo_l
MIN_FACE_CONFIDENCE=0.5
MATCH_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.55
ALERT_COOLDOWN_SECONDS=5.0

# Video Motion Detection (Skip static CCTV frames)
MOTION_DETECTION_ENABLED=true
MOTION_PIXEL_THRESHOLD=25
MOTION_AREA_THRESHOLD=0.005
